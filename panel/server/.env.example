# PhantomRipperRMM Panel — environment
# Copy to .env and edit. Never commit the real .env.

# Server
PORT=8443
HOST=0.0.0.0
NODE_ENV=production

# Auth — CHANGE THIS. Long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=12h

# Bootstrap admin (created on first boot if no users exist)
ADMIN_USER=operator
ADMIN_PASS=changeme

# ---- Database --------------------------------------------------------------
# Leave MYSQL_URL empty to use the built-in SQLite (great for local dev).
# On Railway, add a MySQL service and reference its variables, e.g.:
#   MYSQL_URL=${{MySQL.MYSQL_URL}}
# The panel also auto-detects DATABASE_URL / MYSQL_URL / MYSQLHOST+MYSQLPORT...
MYSQL_URL=
DB_PATH=./data/phantomripper.db

# Payload builder
PYTHON_BIN=python
PAYLOAD_DIR=../../payloads
BUILD_DIR=./data/builds

# Public C2 address agents beacon back to (used in generated payloads)
C2_HOST=your-domain.example.com
C2_PORT=8443
C2_SCHEME=https

# Optional integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NGROK_AUTHTOKEN=

# ── v0.2 weaponization ──
# New-session webhooks (optional)
TELEGRAM_NOTIFY_TOKEN=
TELEGRAM_NOTIFY_CHAT=
DISCORD_NOTIFY_URL=
# Panel version: 0.2.0 (task protocol, artifacts, ws relay, builder modules)
